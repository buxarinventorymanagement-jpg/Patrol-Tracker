# ====================================================================
# SUPABASE POSTGRESQL ENVIRONMENT CONFIGURATION
# Copy or rename this file to .env and fill in your Supabase DB credentials
# ====================================================================

# Option 1: Full JDBC URL (Direct Connection or Connection Pooler)
# Format: jdbc:postgresql://db.<YOUR-PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
# Or Pooler: jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Database Username (default: postgres)
SUPABASE_DB_USER=postgres

# Database Password (The password you set when creating the Supabase project)
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_PASSWORD

# Database Driver Class Name
SUPABASE_DB_DRIVER=org.postgresql.Driver
